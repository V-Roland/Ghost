{
  "name": "ghost-interview-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "Ghost: secure human-in-the-loop interview evidence copilot prototype.",
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/frontend",
    "apps/api"
  ],
  "scripts": {
    "setup": "npm install",
    "dev": "npm run dev --workspace apps/frontend",
    "dev:api": "npm run dev --workspace apps/api",
    "build": "npm run build --workspace apps/frontend",
    "preview": "npm run preview --workspace apps/frontend",
    "supabase:preflight": "node scripts/preflightSupabase.js",
    "supabase:push": "supabase db push",
    "supabase:seed": "node scripts/seedSupabase.js",
    "supabase:verify": "node scripts/verifySupabase.js",
    "supabase:verify-isolation": "node scripts/verifySupabaseIsolation.js",
    "supabase:reset-local": "supabase db reset",
    "lint:structure": "node scripts/checkRepoStructure.js",
    "lint:guardrails": "node scripts/checkGuardrails.js",
    "test:api": "node --test apps/api/test/authSecurity.test.js apps/api/test/interviewLifecycle.test.js apps/api/test/supabaseError.test.js",
    "test:frontend": "node --test apps/frontend/test/archiveRecords.test.js",
    "test:supabase": "node --test scripts/test/supabaseSchema.test.js",
    "test": "npm run test:api && npm run test:frontend && npm run test:supabase",
    "check": "npm run lint:structure && npm run lint:guardrails && npm run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.55.0",
    "dotenv": "^16.4.5"
  }
}

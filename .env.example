# Local API configuration
NODE_ENV=development
PORT=7071
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUEST_BODY_LIMIT=256kb

# Supabase API configuration
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_project-key>
# Server-only. Never use this value in VITE_* variables or browser code.
SUPABASE_SERVICE_ROLE_KEY=<sb_secret_service-role-key>

# Demo seed values for disposable development projects only
ALLOW_DEMO_SEED=false
ALLOW_REMOTE_DEMO_SEED=false
ALLOW_RLS_TESTS=false
ALLOW_REMOTE_RLS_TESTS=false
DEMO_USER_EMAIL=nick@example.com
DEMO_USER_DISPLAY_NAME=Nick Steltzner
DEMO_USER_PASSWORD=
DEMO_SECONDARY_USER_EMAIL=sally@example.com
DEMO_SECONDARY_USER_DISPLAY_NAME=Sally Chen
DEMO_SECONDARY_USER_PASSWORD=

# Optional future services
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
MICROSOFT_GRAPH_TENANT_ID=<tenant-id>
MICROSOFT_GRAPH_CLIENT_ID=<client-id>
MICROSOFT_GRAPH_CLIENT_SECRET=<client-secret>
